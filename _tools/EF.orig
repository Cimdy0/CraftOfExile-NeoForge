package com.cimdy.coe.data.gen.essence;

import com.cimdy.coe.data.codec.item.addition.ModAdditions;
import com.cimdy.coe.data.codec.item.essence.EssenceFamily;
import com.cimdy.coe.data.codec.item.mod.Location;
import com.cimdy.coe.data.codec.item.tiered.BonusFamily;

import java.util.LinkedHashMap;
import java.util.Map;

import static com.cimdy.coe.data.codec.item.tiered.BonusFamily.bonus;
import static com.cimdy.coe.data.codec.item.tiered.BonusFamily.branch;

/**
 * 精髓族<b>数据声明</b>（生成期的「存储类」）：一族一条 {@link BonusFamily}，
 * <b>含该族全部阶</b>（{@code LESSER → NORMAL → GREATER → PERFECT} 或腐化单阶 {@code SPECIAL}）。
 *
 * <h2>与运行时存储类 {@code EssenceState} 的分工</h2>
 * <ul>
 *   <li>本类（生成侧）：<b>同族所有阶</b>集中在一条 {@link BonusFamily} 里 —— 一族一个 JSON 文件
 *       （{@code data/coe/item/essence/<族名>.json}），扁平 {@code bonuses} 表每条 {@code TieredBonus} 自带分支与阶；
 *       {@code location}（prefix / suffix）<b>逐条词缀声明</b>（见 {@code Bonus}），不在族级也不在条目级；</li> *   <li>{@code EssenceState}（运行侧）：<b>只含对应那一阶</b>的数据 —— 由 {@code EssenceRegistry}
 *       按阶展开时经 {@link BonusFamily#resolve} 抽出一阶的 {@code Map<String, List<Bonus>>}
 *       （已无 {@code tier} 字段），加上族名 / 阶 即该条目全部属性。</li>
 * </ul>
 * 二者因此<b>彼此分离</b>：本类不被任何运行时代码引用，只被 {@code EssenceFamilyProvider} 读取落盘。
 *
 * <h2>建造者逐阶声明</h2>
 * 每次 {@code .tier(...)} 设定<b>下一阶</b>（从低往高）；只调用一次即 {@code SPECIAL}（腐化精髓）。
 * 加成 {@code type} 直接给 <b>{@code ModAdditions} 常量</b>（{@code AdditionRead}），不写字符串 id —— 键写错在编译期即暴露；生成期只编码 ref、不解析。
 *
 * <p>精髓<b>没有需求等级概念</b>（该维度为符文专有）；族名与条目 id 不入 JSON，由「族名 + 阶」派生。</p>
 */
public final class EssenceFamilies {

    private EssenceFamilies() {
    }

    /** 族名（键即文件名）→ 该族全部分阶加成。 */
    private static final Map<String, EssenceFamily> FAMILIES = new LinkedHashMap<>();

