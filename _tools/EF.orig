    /** 精髓工厂：文件名即精髓名（{@code abrasion_essence.json → Abrasion}），名称不落盘。 */
    private static void family(String fileName, BonusFamily bonuses) {
        FAMILIES.put(fileName, EssenceFamily.of(bonuses));
    }

    /** 全部精髓族（生成期只读）。 */
    public static Map<String, EssenceFamily> families() {
        return FAMILIES;
    }
